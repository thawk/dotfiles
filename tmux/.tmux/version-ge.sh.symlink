#!/usr/bin/env bash
# Time: 2020-08-21 23:08:42

target_version=$1
tmux_version="$(tmux -V | sed -En "s/^tmux[[:space:]]+([^[:space:]]+[[:space:]]+)?([.0-9]+).*/\2/p")"
[[ -z "$target_version" ]] && exit 0

IFS=. read -ra a <<< "$tmux_version"
IFS=. read -ra b <<< "$target_version"
n=${#a[@]}; (( ${#b[@]} > n )) && n=${#b[@]}
for ((i=0; i<n; i++)); do
  x=${a[i]:-0}; y=${b[i]:-0}
  x=$((10#$x)); y=$((10#$y))
  if (( x < y )); then exit 1; fi
  if (( x > y )); then exit 0; fi
done
exit 0
